// Prisma Schema for Optica Glasses E-Commerce Platform
// Supports: Products, Variants, Orders, Users, RBAC, Coupons, Reviews

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTHENTICATION ====================

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Relations
  addresses     Address[]
  orders        Order[]
  cart          Cart?
  reviews       Review[]
  wishlist      WishlistItem[]
  sessions      Session[]
  apiKeys       ApiKey[]
  notifications Notification[]

  // Optica Proprietary Tech Relations
  faceAnalyses        FaceAnalysis[]
  prescriptions       PrescriptionRecord[]
  lensRecommendations LensRecommendation[]
  tryOnSessions       VirtualTryOnSession[]
  fitFeedback         FitFeedback[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  key         String    @unique
  permissions String[]  // Array of permission strings
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  firstName   String
  lastName    String
  company     String?
  address1    String
  address2    String?
  city        String
  state       String
  postalCode  String
  country     String  @default("US")
  phone       String?
  isDefault   Boolean @default(false)
  isBilling   Boolean @default(false)
  isShipping  Boolean @default(true)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ==================== PRODUCTS & CATALOG ====================

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([slug])
  @@index([parentId])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logo        String?
  website     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@index([slug])
}

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  shortDescription String?
  sku             String   @unique
  barcode         String?

  // Pricing
  price           Decimal  @db.Decimal(10, 2)
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  costPrice       Decimal? @db.Decimal(10, 2)

  // Glasses-specific attributes
  frameType       FrameType?
  frameShape      FrameShape?
  frameMaterial   FrameMaterial?
  frameWidth      String?       // e.g., "Narrow", "Medium", "Wide"
  lensWidth       Int?          // in mm
  bridgeWidth     Int?          // in mm
  templeLength    Int?          // in mm
  lensHeight      Int?          // in mm
  frameWeight     Int?          // in grams

  // For accessories
  accessoryType   AccessoryType?

  // Status & visibility
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  isNewArrival    Boolean  @default(false)
  isBestSeller    Boolean  @default(false)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Inventory
  trackInventory  Boolean  @default(true)
  quantity        Int      @default(0)
  lowStockThreshold Int    @default(5)

  // Timestamps
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  categoryId      String?
  brandId         String?
  category        Category?       @relation(fields: [categoryId], references: [id])
  brand           Brand?          @relation(fields: [brandId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  reviews         Review[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  collections     CollectionProduct[]
  tags            ProductTag[]

  // Optica Proprietary Tech Relations
  frameRecommendations FrameRecommendation[]
  fitFeedback          FitFeedback[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, isFeatured])
}

enum FrameType {
  FULL_RIM
  SEMI_RIMLESS
  RIMLESS
}

enum FrameShape {
  RECTANGLE
  SQUARE
  ROUND
  OVAL
  CAT_EYE
  AVIATOR
  BROWLINE
  GEOMETRIC
  OVERSIZED
  WRAP
}

enum FrameMaterial {
  ACETATE
  METAL
  TITANIUM
  TR90
  WOOD
  MIXED
  PLASTIC
  STAINLESS_STEEL
}

enum AccessoryType {
  CASE
  CLEANING_KIT
  LENS_CLOTH
  CHAIN
  STRAP
  NOSE_PADS
  TEMPLE_TIPS
  REPAIR_KIT
  ANTI_FOG_SPRAY
  OTHER
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  name          String   // e.g., "Black / Prescription"
  sku           String   @unique

  // Variant-specific attributes
  color         String?
  colorCode     String?  // Hex color code
  size          String?
  lensType      LensType?

  // Pricing (overrides product price if set)
  price         Decimal? @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)

  // Inventory
  quantity      Int      @default(0)

  // Image
  image         String?

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  cartItems     CartItem[]

  @@index([productId])
  @@index([sku])
}

enum LensType {
  CLEAR
  BLUE_LIGHT
  PHOTOCHROMIC
  POLARIZED
  SUNGLASSES
  READING
  PROGRESSIVE
  BIFOCAL
  NON_PRESCRIPTION
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]

  @@index([slug])
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products CollectionProduct[]

  @@index([slug])
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

// ==================== SHOPPING CART ====================

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  expiresAt DateTime?

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([sessionId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int     @default(1)

  // Prescription data (JSON for flexibility)
  prescription Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

// ==================== ORDERS ====================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  ON_HOLD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED
}

model Order {
  id              String            @id @default(cuid())
  orderNumber     String            @unique
  userId          String?

  // Status
  status          OrderStatus       @default(PENDING)
  paymentStatus   PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  // Pricing
  subtotal        Decimal           @db.Decimal(10, 2)
  discountTotal   Decimal           @default(0) @db.Decimal(10, 2)
  shippingTotal   Decimal           @default(0) @db.Decimal(10, 2)
  taxTotal        Decimal           @default(0) @db.Decimal(10, 2)
  total           Decimal           @db.Decimal(10, 2)

  // Currency
  currency        String            @default("USD")

  // Customer info (denormalized for order history)
  email           String
  phone           String?

  // Addresses (JSON for historical accuracy)
  shippingAddress Json
  billingAddress  Json?

  // Payment
  stripePaymentIntentId String?     @unique
  stripeChargeId        String?

  // Shipping
  shippingMethod  String?
  trackingNumber  String?
  trackingUrl     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?

  // Coupon
  couponId        String?
  couponCode      String?

  // Notes
  customerNote    String?
  internalNote    String?

  // Timestamps
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  user            User?             @relation(fields: [userId], references: [id])
  address         Address?          @relation(fields: [addressId], references: [id])
  addressId       String?
  items           OrderItem[]
  coupon          Coupon?           @relation(fields: [couponId], references: [id])
  transactions    Transaction[]
  timeline        OrderTimeline[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  variantId     String?

  // Snapshot data (denormalized)
  name          String
  sku           String
  image         String?

  // Pricing at time of purchase
  price         Decimal @db.Decimal(10, 2)
  quantity      Int
  total         Decimal @db.Decimal(10, 2)

  // Prescription data
  prescription  Json?

  // Fulfillment
  fulfilledQuantity Int @default(0)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  createdBy String?  // User ID who made the change

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Transaction {
  id            String   @id @default(cuid())
  orderId       String
  type          TransactionType
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD")
  status        String
  stripeId      String?
  metadata      Json?
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum TransactionType {
  CHARGE
  REFUND
  PARTIAL_REFUND
}

// ==================== REVIEWS ====================

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int      // 1-5
  title      String?
  content    String?
  images     String[] // Array of image URLs
  isVerified Boolean  @default(false) // Verified purchase
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

// ==================== WISHLIST ====================

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ==================== MARKETING & COUPONS ====================

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y
}

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  description     String?
  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(10, 2)

  // Conditions
  minimumPurchase Decimal?     @db.Decimal(10, 2)
  maximumDiscount Decimal?     @db.Decimal(10, 2)

  // Usage limits
  usageLimit      Int?
  usageCount      Int          @default(0)
  usageLimitPerUser Int?

  // Validity
  startsAt        DateTime     @default(now())
  expiresAt       DateTime?
  isActive        Boolean      @default(true)

  // Restrictions
  applicableProducts String[]  // Product IDs (empty = all)
  applicableCategories String[] // Category IDs (empty = all)
  excludedProducts String[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orders Order[]

  @@index([code])
}

model Newsletter {
  id         String   @id @default(cuid())
  email      String   @unique
  firstName  String?
  isActive   Boolean  @default(true)
  source     String?  // Where they signed up
  createdAt  DateTime @default(now())

  @@index([email])
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== SETTINGS & CONFIG ====================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ==================== OPTICA PROPRIETARY TECH ====================

// -------------------- OpticaVision: Face Analysis --------------------

enum FaceShape {
  OVAL
  ROUND
  SQUARE
  HEART
  OBLONG
  DIAMOND
  TRIANGLE
}

enum SkinTone {
  WARM
  COOL
  NEUTRAL
}

model FaceAnalysis {
  id                String    @id @default(cuid())
  userId            String?
  sessionId         String?   // For anonymous users

  // Face Shape Classification
  faceShape         FaceShape
  faceShapeConfidence Float   @default(0)

  // Facial Measurements (in mm)
  faceWidth         Float     // Temple to temple
  faceLength        Float     // Forehead to chin
  foreheadWidth     Float
  cheekboneWidth    Float
  jawWidth          Float
  noseBridgeHeight  Float?
  noseBridgeWidth   Float?

  // Derived Proportions
  widthToLengthRatio Float
  foreheadToJawRatio Float

  // Color Analysis
  skinTone          SkinTone?
  hairColor         String?   // Primary detected hair color
  eyeColor          String?   // Primary detected eye color

  // Recommended Frame Attributes
  recommendedShapes     FrameShape[]
  recommendedMaterials  FrameMaterial[]
  recommendedColors     String[]        // Hex codes

  // Optimal Frame Dimensions
  optimalFrameWidth     Int?            // mm
  optimalBridgeWidth    Int?            // mm
  optimalTempleLength   Int?            // mm

  // Processing metadata
  imageHash         String?             // Hash of analyzed image (privacy)
  processingVersion String   @default("1.0")
  processedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations   FrameRecommendation[]
  tryOnSessions     VirtualTryOnSession[]

  @@index([userId])
  @@index([sessionId])
  @@index([faceShape])
}

model FrameRecommendation {
  id                String   @id @default(cuid())
  faceAnalysisId    String
  productId         String

  // Scoring
  overallScore      Float    // 0-100 composite score
  shapeScore        Float    // How well shape complements face
  sizeScore         Float    // How well dimensions fit
  colorScore        Float    // Color harmony score
  styleScore        Float    // Style preference match

  // Explanations
  matchReasons      String[] // ["Rectangular frames balance round faces", ...]
  warnings          String[] // ["Frame may be too wide", ...]

  // Ranking
  rank              Int      // Position in recommendations

  // Feedback
  userFeedback      String?  // LIKED, DISLIKED, PURCHASED, RETURNED
  feedbackAt        DateTime?

  createdAt         DateTime @default(now())

  faceAnalysis      FaceAnalysis @relation(fields: [faceAnalysisId], references: [id], onDelete: Cascade)
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([faceAnalysisId, productId])
  @@index([faceAnalysisId])
  @@index([productId])
  @@index([overallScore])
}

// -------------------- OpticaScan: Prescription Verification --------------------

enum PrescriptionStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  EXPIRED
}

model PrescriptionRecord {
  id                String             @id @default(cuid())
  userId            String

  // Prescription Values - Right Eye (OD)
  odSphere          Float?             // -20.00 to +20.00
  odCylinder        Float?             // -6.00 to +6.00
  odAxis            Int?               // 1 to 180
  odAdd             Float?             // For progressives/bifocals
  odPrism           Float?
  odPrismDirection  String?            // BU, BD, BI, BO

  // Prescription Values - Left Eye (OS)
  osSphere          Float?
  osCylinder        Float?
  osAxis            Int?
  osAdd             Float?
  osPrism           Float?
  osPrismDirection  String?

  // Pupillary Distance
  pdSingle          Float?             // Single PD
  pdRight           Float?             // Monocular PD - Right
  pdLeft            Float?             // Monocular PD - Left

  // Prescription Metadata
  prescribedDate    DateTime?
  expirationDate    DateTime?
  prescriberName    String?
  prescriberLicense String?
  prescriberPhone   String?
  clinicName        String?
  clinicAddress     String?

  // Verification
  status            PrescriptionStatus @default(PENDING_VERIFICATION)
  verifiedAt        DateTime?
  verifiedBy        String?            // Staff user ID
  rejectionReason   String?

  // Source
  sourceType        String             // MANUAL, OCR_SCAN, API_IMPORT
  sourceImageUrl    String?            // Encrypted reference
  ocrConfidence     Float?             // 0-1 confidence score
  ocrRawData        Json?              // Raw OCR extraction

  // Privacy
  isActive          Boolean  @default(true)
  consentGiven      Boolean  @default(false)
  consentAt         DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lensRecommendations LensRecommendation[]
  shareLinks        PrescriptionShare[]

  @@index([userId])
  @@index([status])
  @@index([expirationDate])
}

// -------------------- OpticaVault: Prescription Sharing --------------------

model PrescriptionShare {
  id                  String   @id @default(cuid())
  prescriptionId      String

  // Share Token
  shareToken          String   @unique @default(cuid())

  // Access Control
  recipientEmail      String?
  recipientName       String?
  accessCount         Int      @default(0)
  maxAccessCount      Int?     // null = unlimited

  // Validity
  expiresAt           DateTime?
  isActive            Boolean  @default(true)

  // Audit
  lastAccessedAt      DateTime?
  lastAccessedBy      String?  // IP or identifier

  createdAt           DateTime @default(now())

  prescription        PrescriptionRecord @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([shareToken])
  @@index([prescriptionId])
}

// -------------------- OpticaLens: Lens Configuration --------------------

enum LensIndex {
  STANDARD_1_50       // CR-39, standard
  MID_INDEX_1_56
  MID_INDEX_1_59      // Polycarbonate
  HIGH_INDEX_1_60
  HIGH_INDEX_1_67
  ULTRA_HIGH_1_74
}

enum LensCoating {
  ANTI_REFLECTIVE
  BLUE_LIGHT_FILTER
  SCRATCH_RESISTANT
  UV_PROTECTION
  ANTI_SMUDGE
  HYDROPHOBIC
  PHOTOCHROMIC
  POLARIZED
  MIRROR
}

model LensRecommendation {
  id                  String   @id @default(cuid())
  prescriptionId      String?
  userId              String?
  sessionId           String?

  // Input Context
  usageType           String   // EVERYDAY, COMPUTER, READING, DRIVING, SPORTS
  budgetRange         String   // BUDGET, MID_RANGE, PREMIUM
  priorityFactors     String[] // THIN_LIGHT, DURABILITY, CLARITY, PROTECTION

  // Recommended Configuration
  lensIndex           LensIndex
  lensDesign          String   // SINGLE_VISION, PROGRESSIVE, BIFOCAL, OFFICE
  recommendedCoatings LensCoating[]

  // Calculated Values
  estimatedThicknessCenter Float? // mm
  estimatedThicknessEdge   Float? // mm
  estimatedWeight          Float? // grams per lens

  // Pricing
  estimatedCost       Float?

  // Explanation
  recommendations     Json     // Detailed explanation object

  createdAt           DateTime @default(now())

  prescription        PrescriptionRecord? @relation(fields: [prescriptionId], references: [id])
  user                User?    @relation(fields: [userId], references: [id])

  @@index([prescriptionId])
  @@index([userId])
  @@index([sessionId])
}

// -------------------- OpticaFit: Virtual Try-On --------------------

model VirtualTryOnSession {
  id                String   @id @default(cuid())
  userId            String?
  sessionId         String?
  faceAnalysisId    String?

  // Session Data
  productsViewed    String[] // Product IDs
  productsSaved     String[] // Products user liked
  timeSpentSeconds  Int      @default(0)

  // Device Info
  deviceType        String?  // MOBILE, TABLET, DESKTOP
  browserInfo       String?

  // Conversion
  addedToCart       Boolean  @default(false)
  purchased         Boolean  @default(false)
  orderId           String?

  // Quality Metrics
  renderQuality     String?  // LOW, MEDIUM, HIGH
  userRating        Int?     // 1-5 rating of experience

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User?         @relation(fields: [userId], references: [id])
  faceAnalysis      FaceAnalysis? @relation(fields: [faceAnalysisId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([faceAnalysisId])
}

// -------------------- ML Training Data Collection --------------------

model FitFeedback {
  id                String   @id @default(cuid())
  userId            String?
  orderId           String?
  productId         String

  // Fit Assessment
  overallFit        Int      // 1-5
  widthFit          String?  // TOO_NARROW, PERFECT, TOO_WIDE
  bridgeFit         String?  // TOO_TIGHT, PERFECT, TOO_LOOSE
  templeFit         String?  // TOO_SHORT, PERFECT, TOO_LONG
  weightComfort     Int?     // 1-5

  // Comparison to Expectation
  matchedExpectation Boolean?

  // Free-form
  comments          String?

  // Used for Training
  includedInTraining Boolean @default(false)

  createdAt         DateTime @default(now())

  user              User?    @relation(fields: [userId], references: [id])
  product           Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([userId])
}
